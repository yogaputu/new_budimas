from  apps.handler import  *
from  apps.helper  import  *
from  apps.widget  import  *
from  sqlalchemy   import  desc, text
from  .            import  Base
from  apps.lib.query import DB
from  apps.models  import  (
      Produk,
      ProdukUOM as UOM,
      ProdukHargaJual,
      ProdukTipeHarga,
      ProdukBrand,
      ProdukKategori
)
from flask import request
from sqlalchemy import or_
import re
from apps.lib.schema_guard import require_table_columns, require_tables


class ProdukService(Base) :

    def __init__(self) :
        super().__init__()

    def req(self, key, default=None):
        return self.data.get(key, default)

    def query(self):
        return DB()

    @staticmethod
    def _status_label(value):
        if value in (1, '1'):
            return 'Aktif'
        if value in (0, '0'):
            return 'Nonaktif'
        if value in (None, '', 'None'):
            return 'Belum diatur'
        return f'Status {value}'

    def _build_detail_payload(self, product):
        if not product:
            return {}

        brand_name = None
        category_name = None
        subbrand_name = None

        if getattr(product, 'id_brand', None):
            brand = ProdukBrand.query.filter_by(id=product.id_brand).first()
            brand_name = brand.nama if brand else None

        if getattr(product, 'id_kategori', None):
            category = ProdukKategori.query.filter_by(id=product.id_kategori).first()
            category_name = category.nama if category else None

        if getattr(product, 'id_subbrand', None):
            subbrand_name = self._get_subbrand_name(product.id_subbrand)

        detail = {
            'produk_id': product.id,
            'id': product.id,
            'id_principal': getattr(product, 'id_principal', None),
            'id_brand': getattr(product, 'id_brand', None),
            'id_kategori': getattr(product, 'id_kategori', None),
            'id_subbrand': getattr(product, 'id_subbrand', None),
            'id_ppn': getattr(product, 'id_ppn', None),
            'id_status': getattr(product, 'id_status', None),
            'kode_sku': getattr(product, 'kode_sku', None),
            'kode_ean': getattr(product, 'kode_ean', None),
            'nama': getattr(product, 'nama', None),
            'harga_beli': getattr(product, 'harga_beli', None),
            'harga_jual': getattr(product, 'harga_jual', None),
            'kubikasiperbox': getattr(product, 'kubikasiperbox', None),
            'kubikasiperkarton': getattr(product, 'kubikasiperkarton', None),
            'isiperbox': getattr(product, 'isiperbox', None),
            'isiperkarton': getattr(product, 'isiperkarton', None),
            'satuan': getattr(product, 'satuan', None),
            'kubikasiperpieces': getattr(product, 'kubikasiperpieces', None),
            'ppn': getattr(product, 'ppn', None),
            'ppn_nama': None,
            'ppn_kode': None,
            'keterangan': getattr(product, 'keterangan', None),
            'brand_nama': brand_name,
            'kategori_nama': category_name,
            'subbrand_nama': subbrand_name,
        }

        detail['status_label'] = self._status_label(detail.get('id_status'))
        if detail.get('id_ppn'):
            ppn_row = self.db.session.execute(
                text("""
                    SELECT kode, nama, persentase
                    FROM master_ppn
                    WHERE id = :id_ppn
                    LIMIT 1
                """),
                {"id_ppn": detail.get("id_ppn")}
            ).mappings().first()
            if ppn_row:
                detail['ppn'] = ppn_row.get('persentase')
                detail['ppn_nama'] = ppn_row.get('nama')
                detail['ppn_kode'] = ppn_row.get('kode')
        detail['uoms'] = self.fetch_uoms(product.id)
        detail['prices'] = self.fetch_price_history(product.id)
        detail['external_mappings'] = self.fetch_external_mappings(product.id)
        detail['kode_external'] = ', '.join(
            item.get('kode_external') for item in detail['external_mappings'] if item.get('kode_external')
        )
        return detail

    def _ensure_product_external_mapping_table(self):
        require_table_columns(
            self.db.session,
            "produk_external_mapping",
            [
                "id",
                "kode_external",
                "id_produk",
                "kode_sku",
                "principal_code",
                "source",
                "is_active",
                "created_at",
                "updated_at",
            ],
            "tools/migrations/20260519_runtime_schema_manual.sql",
        )

    def _parse_external_codes(self, value):
        if value in (None, ''):
            return []

        if isinstance(value, (list, tuple)):
            raw_values = value
        else:
            raw_values = str(value).replace('\n', ',').replace(';', ',').split(',')

        codes = []
        seen = {}
        for item in raw_values:
            code = str(item or '').strip()
            if not code or code in seen:
                continue
            seen[code] = True
            codes.append(code)
        return codes

    def _get_subbrand_name(self, id_subbrand):
        if id_subbrand in (None, '', 'None'):
            return None

        row = self.db.session.execute(
            text("""
                SELECT nama
                FROM produk_subbrand
                WHERE id = :id_subbrand
                LIMIT 1
            """),
            {'id_subbrand': id_subbrand}
        ).mappings().first()
        return row.get('nama') if row else None

    def _ensure_ppn_schema(self):
        require_tables(
            self.db.session,
            {
                "master_ppn": [
                    "id",
                    "kode",
                    "nama",
                    "persentase",
                    "is_active",
                    "keterangan",
                    "created_at",
                    "updated_at",
                ],
                "produk": ["id_ppn"],
            },
            "tools/migrations/20260519_runtime_schema_manual.sql",
        )

    @handle_error
    def fetch_ppn_options(self):
        self._ensure_ppn_schema()
        rows = self.db.session.execute(text("""
            SELECT id, kode, nama, persentase, is_active, keterangan
            FROM master_ppn
            WHERE COALESCE(is_active, TRUE) = TRUE
            ORDER BY persentase ASC, nama ASC, id ASC
        """)).mappings().all()

        return [
            {
                **dict(row),
                "text": f"{row['nama']} ({float(row['persentase'] or 0):g}%)"
            }
            for row in rows
        ]

    @handle_error
    def fetch_ppn_list(self):
        self._ensure_ppn_schema()
        search = (request.args.get('search') or '').strip()
        params = {}
        where = ""
        if search:
            where = """
                WHERE kode ILIKE :search
                   OR nama ILIKE :search
                   OR COALESCE(keterangan, '') ILIKE :search
            """
            params["search"] = f"%{search}%"

        rows = self.db.session.execute(
            text(f"""
                SELECT
                    mp.id,
                    mp.kode,
                    mp.nama,
                    mp.persentase,
                    mp.is_active,
                    mp.keterangan,
                    COUNT(p.id) AS total_produk
                FROM master_ppn mp
                LEFT JOIN produk p ON p.id_ppn = mp.id
                {where}
                GROUP BY mp.id, mp.kode, mp.nama, mp.persentase, mp.is_active, mp.keterangan
                ORDER BY mp.persentase ASC, mp.nama ASC, mp.id ASC
            """),
            params
        ).mappings().all()
        return [dict(row) for row in rows]

    def _normalize_ppn_payload(self, payload):
        kode = str(payload.get('kode') or '').strip().upper()
        nama = str(payload.get('nama') or '').strip()
        if not kode:
            raise nonServerErrorException('Kode PPN wajib diisi', 400)
        if not nama:
            raise nonServerErrorException('Nama PPN wajib diisi', 400)

        try:
            persentase = float(payload.get('persentase') or 0)
        except (TypeError, ValueError):
            raise nonServerErrorException('Persentase PPN harus berupa angka', 400)

        is_active_raw = payload.get('is_active', True)
        is_active = is_active_raw in (True, 1, '1', 'true', 'TRUE', 'True', 'on', 'ON', 'ya', 'YA')

        return {
            'kode': kode,
            'nama': nama,
            'persentase': max(0, persentase),
            'is_active': is_active,
            'keterangan': payload.get('keterangan') or None
        }

    @handle_error_rollback
    def create_ppn(self):
        self._ensure_ppn_schema()
        payload = self._normalize_ppn_payload(request.get_json(silent=True) or {})
        row = self.db.session.execute(
            text("""
                INSERT INTO master_ppn (kode, nama, persentase, is_active, keterangan, updated_at)
                VALUES (:kode, :nama, :persentase, :is_active, :keterangan, NOW())
                RETURNING id, kode, nama, persentase, is_active, keterangan
            """),
            payload
        ).mappings().first()
        self.db.session.commit()
        return dict(row)

    @handle_error_rollback
    def update_ppn(self, id):
        self._ensure_ppn_schema()
        payload = self._normalize_ppn_payload(request.get_json(silent=True) or {})
        payload['id'] = int(id)
        row = self.db.session.execute(
            text("""
                UPDATE master_ppn
                SET kode = :kode,
                    nama = :nama,
                    persentase = :persentase,
                    is_active = :is_active,
                    keterangan = :keterangan,
                    updated_at = NOW()
                WHERE id = :id
                RETURNING id, kode, nama, persentase, is_active, keterangan
            """),
            payload
        ).mappings().first()
        if not row:
            raise nonServerErrorException('Master PPN tidak ditemukan', 404)

        self.db.session.execute(
            text("""
                UPDATE produk
                SET ppn = :persentase
                WHERE id_ppn = :id
            """),
            {'id': int(id), 'persentase': payload['persentase']}
        )
        self.db.session.commit()
        return dict(row)

    @handle_error_rollback
    def delete_ppn(self, id):
        self._ensure_ppn_schema()
        total_produk = self.db.session.execute(
            text("SELECT COUNT(*) AS total FROM produk WHERE id_ppn = :id"),
            {'id': int(id)}
        ).mappings().first()
        if int((total_produk or {}).get('total') or 0) > 0:
            raise nonServerErrorException('Master PPN masih dipakai produk, tidak bisa dihapus.', 400)

        deleted = self.db.session.execute(
            text("DELETE FROM master_ppn WHERE id = :id RETURNING id"),
            {'id': int(id)}
        ).mappings().first()
        if not deleted:
            raise nonServerErrorException('Master PPN tidak ditemukan', 404)

        self.db.session.commit()
        return {'id': int(id), 'status': 'deleted'}

    def fetch_external_mappings(self, id_produk):
        self._ensure_product_external_mapping_table()
        rows = self.db.session.execute(
            text("""
                SELECT id, kode_external, kode_sku, principal_code, source, is_active
                FROM produk_external_mapping
                WHERE id_produk = :id_produk
                  AND source = 'sales_order_import'
                  AND is_active = TRUE
                ORDER BY kode_external ASC
            """),
            {'id_produk': id_produk}
        ).mappings().all()
        return [dict(row) for row in rows]

    def _sync_external_mappings(self, product, payload):
        if 'kode_external' not in payload and 'external_codes' not in payload:
            return

        self._ensure_product_external_mapping_table()
        external_codes = self._parse_external_codes(payload.get('kode_external', payload.get('external_codes')))

        self.db.session.execute(
            text("""
                UPDATE produk_external_mapping
                SET is_active = FALSE, updated_at = NOW()
                WHERE id_produk = :id_produk
                  AND source = 'sales_order_import'
            """),
            {'id_produk': product.id}
        )

        for external_code in external_codes:
            self.db.session.execute(
                text("""
                    INSERT INTO produk_external_mapping (
                        kode_external, id_produk, kode_sku, source, is_active, updated_at
                    )
                    VALUES (
                        :kode_external, :id_produk, :kode_sku, 'sales_order_import', TRUE, NOW()
                    )
                    ON CONFLICT (kode_external, source)
                    DO UPDATE SET
                        id_produk = EXCLUDED.id_produk,
                        kode_sku = EXCLUDED.kode_sku,
                        is_active = TRUE,
                        updated_at = NOW()
                """),
                {
                    'kode_external': external_code,
                    'id_produk': product.id,
                    'kode_sku': getattr(product, 'kode_sku', None)
                }
            )

    def _clean_params(self):
        params = self.set_param()
        return {
            key: value for key, value in params.items()
            if value not in (None, '', 'None') and key not in ('search', 'filters', 'limit', 'start', 'length', 'branchId', 'route', 'tokens')
        }


    @handle_error
    def fetch_option(self) :
        params = {}
        where_parts = []
        allowed_filters = {
            'id',
            'id_principal',
            'id_brand',
            'id_kategori',
            'id_subbrand',
            'id_status',
        }

        for key, value in self._clean_params().items():
            if key in allowed_filters:
                where_parts.append(f"{key} = :{key}")
                params[key] = value

        search = request.args.get('search') or request.args.get('filters')
        if search not in (None, '', 'None'):
            params['search'] = f"%{search}%"
            where_parts.append("(nama ILIKE :search OR kode_sku ILIKE :search)")

        limit_clause = ''
        limit = request.args.get('limit') or request.args.get('length')
        if limit not in (None, '', 'None'):
            try:
                params['limit'] = max(1, min(int(limit), 100))
            except (TypeError, ValueError):
                params['limit'] = 50
            limit_clause = 'LIMIT :limit'

        where_clause = f"WHERE {' AND '.join(where_parts)}" if where_parts else ''
        rows = self.db.session.execute(
            text(f"""
                SELECT id, kode_sku AS kode, nama
                FROM produk
                {where_clause}
                ORDER BY nama ASC, id ASC
                {limit_clause}
            """),
            params
        ).mappings().all()

        return [dict(row) for row in rows]

    

    @handle_error
    def fetch_detail_transaksi(self, id):
        self._ensure_ppn_schema()
        result = (
            Produk.query.with_entities(
                Produk.id.label('produk_id'),
                Produk.id_principal.label('id_principal'),
                Produk.id_brand.label('id_brand'),
                Produk.id_kategori.label('id_kategori'),
                Produk.id_subbrand.label('id_subbrand'),
                Produk.id_ppn.label('id_ppn'),
                Produk.id_status.label('id_status'),
                Produk.kode_sku.label('kode_sku'),
                Produk.kode_ean.label('kode_ean'),
                Produk.nama.label('nama'),
                Produk.harga_beli.label('harga_beli'),
                Produk.harga_jual.label('harga_jual'),
                Produk.kubikasiperbox.label('kubikasiperbox'),
                Produk.kubikasiperkarton.label('kubikasiperkarton'),
                Produk.isiperbox.label('isiperbox'),
                Produk.isiperkarton.label('isiperkarton'),
                Produk.satuan.label('satuan'),
                Produk.kubikasiperpieces.label('kubikasiperpieces'),
                Produk.ppn.label('ppn'),
                Produk.keterangan.label('keterangan'),
                ProdukBrand.nama.label('brand_nama'),
                ProdukKategori.nama.label('kategori_nama'),
            )
            .outerjoin(ProdukBrand, ProdukBrand.id == Produk.id_brand)
            .outerjoin(ProdukKategori, ProdukKategori.id == Produk.id_kategori)
            .filter(Produk.id == id)
            .first()
        )

        if result:
            detail = dict(result._mapping)
            ppn_row = self.db.session.execute(
                text("""
                    SELECT kode, nama, persentase
                    FROM master_ppn
                    WHERE id = :id_ppn
                    LIMIT 1
                """),
                {"id_ppn": detail.get("id_ppn")}
            ).mappings().first() if detail.get("id_ppn") else None
            if ppn_row:
                detail["ppn"] = ppn_row.get("persentase")
                detail["ppn_nama"] = ppn_row.get("nama")
                detail["ppn_kode"] = ppn_row.get("kode")
            detail['subbrand_nama'] = self._get_subbrand_name(detail.get('id_subbrand'))
            detail['status_label'] = self._status_label(detail.get('id_status'))
            detail['uoms'] = self.fetch_uoms(id)
            detail['prices'] = self.fetch_price_history(id)
            detail['external_mappings'] = self.fetch_external_mappings(id)
            detail['kode_external'] = ', '.join(
                item.get('kode_external') for item in detail['external_mappings'] if item.get('kode_external')
            )
            return detail

        product = Produk.query.filter(Produk.id == id).first()
        return self._build_detail_payload(product)


    @handle_error
    def fetch_detail_transaksi_uom(self, id) :
        with self.db.session.begin() :
            return (
                UOM.query.with_entities(
                    UOM  .id               .label('uom_id'             ),
                    UOM  .kode             .label('uom_kode'           ),
                    UOM  .nama             .label('uom_nama'           ),
                    UOM  .level            .label('uom_level'          ),
                    UOM  .faktor_konversi  .label('uom_faktor_konversi'),
                )
                .filter_by(id_produk = id)
                .order_by(desc(UOM.level))
                .all()
            )

    def fetch_uoms(self, id):
        result = (
            UOM.query.with_entities(
                UOM.id,
                UOM.kode,
                UOM.nama,
                UOM.level,
                UOM.faktor_konversi,
                UOM.set_default_sales,
                UOM.set_default_storage,
                UOM.packing_satuan,
                UOM.packing_tinggi,
                UOM.packing_panjang,
                UOM.packing_lebar,
                UOM.berat_satuan,
                UOM.berat_bersih,
                UOM.berat_kotor,
            )
            .filter_by(id_produk=id)
            .order_by(desc(UOM.level))
            .all()
        )

        return Mapper(result).to_dict().get()

    @handle_error
    def fetch_brand_options(self):
        search = (request.args.get('search') or '').strip()

        with self.db.session.begin():
            query = ProdukBrand.query.with_entities(
                ProdukBrand.id,
                ProdukBrand.nama
            )

            if search:
                query = query.filter(ProdukBrand.nama.ilike(f'%{search}%'))

            result = query.order_by(ProdukBrand.nama.asc()).limit(100).all()

        return (
            Mapper(result)
            .to_dict()
            .add_col(lambda item: item['nama'], 'text')
            .get()
        )

    @handle_error
    def fetch_category_options(self):
        search = (request.args.get('search') or '').strip()

        with self.db.session.begin():
            query = ProdukKategori.query.with_entities(
                ProdukKategori.id,
                ProdukKategori.nama
            )

            if search:
                query = query.filter(ProdukKategori.nama.ilike(f'%{search}%'))

            result = query.order_by(ProdukKategori.nama.asc()).limit(100).all()

        return (
            Mapper(result)
            .to_dict()
            .add_col(lambda item: item['nama'], 'text')
            .get()
        )

    @handle_error
    def fetch_subbrand_options(self):
        search = (request.args.get('search') or '').strip()
        id_brand = request.args.get('id_brand')
        include_inactive = str(request.args.get('include_inactive') or '').lower() in ('1', 'true', 'yes')
        limit = request.args.get('limit') or 150

        try:
            limit = max(1, min(int(limit), 1000))
        except (TypeError, ValueError):
            limit = 150

        params = {}
        where = []

        if not include_inactive:
            where.append("COALESCE(ps.is_active, TRUE) = TRUE")

        if search:
            where.append("(ps.nama ILIKE :search OR ps.kode ILIKE :search OR pb.nama ILIKE :search)")
            params['search'] = f'%{search}%'

        if id_brand not in (None, '', 'None'):
            where.append("(ps.id_brand = :id_brand OR ps.id_brand IS NULL)")
            params['id_brand'] = int(id_brand)

        where_clause = f"WHERE {' AND '.join(where)}" if where else ""

        rows = self.db.session.execute(
            text(f"""
                SELECT
                    ps.id,
                    ps.id_brand,
                    ps.kode,
                    ps.nama,
                    ps.keterangan,
                    COALESCE(ps.is_active, TRUE) AS is_active,
                    pb.nama AS brand_nama
                FROM produk_subbrand ps
                LEFT JOIN produk_brand pb ON pb.id = ps.id_brand
                {where_clause}
                ORDER BY pb.nama ASC NULLS LAST, ps.nama ASC
                LIMIT :limit
            """),
            {**params, 'limit': limit}
        ).mappings().all()

        return [
            {
                **dict(row),
                'text': f"{row.get('nama')} ({row.get('brand_nama')})" if row.get('brand_nama') else row.get('nama')
            }
            for row in rows
        ]

    @handle_error_rollback
    def create_subbrand_option(self):
        payload = request.get_json(silent=True) or request.form.to_dict() or self.data or {}
        name = str(payload.get('nama') or payload.get('name') or '').strip()
        id_brand = payload.get('id_brand')

        if not name:
            raise nonServerErrorException('Nama subbrand wajib diisi', 400)

        code = re.sub(r'[^A-Za-z0-9]+', '_', name.upper()).strip('_')[:60] or 'SUBBRAND'
        brand_value = None
        if id_brand not in (None, '', 'None'):
            try:
                brand_value = int(id_brand)
            except (TypeError, ValueError):
                raise nonServerErrorException('Brand harus berupa angka', 400)

        row = self.db.session.execute(
            text("""
                INSERT INTO produk_subbrand (id_brand, kode, nama, keterangan, updated_at)
                VALUES (:id_brand, :kode, :nama, :keterangan, NOW())
                ON CONFLICT (COALESCE(id_brand, 0), LOWER(TRIM(nama))) DO UPDATE SET
                    kode = EXCLUDED.kode,
                    keterangan = EXCLUDED.keterangan,
                    is_active = TRUE,
                    updated_at = NOW()
                RETURNING id, id_brand, kode, nama, keterangan, is_active
            """),
            {
                'id_brand': brand_value,
                'kode': code,
                'nama': name,
                'keterangan': payload.get('keterangan') or 'Input dari master produk'
            }
        ).mappings().first()
        self.db.session.commit()

        result = dict(row)
        result['text'] = result.get('nama')
        return result

    @handle_error_rollback
    def update_subbrand_option(self, id):
        payload = request.get_json(silent=True) or request.form.to_dict() or self.data or {}
        name = str(payload.get('nama') or payload.get('name') or '').strip()
        code = str(payload.get('kode') or '').strip()
        id_brand = payload.get('id_brand')
        is_active = payload.get('is_active')

        if not name:
            raise nonServerErrorException('Nama subbrand wajib diisi', 400)

        if not code:
            code = re.sub(r'[^A-Za-z0-9]+', '_', name.upper()).strip('_')[:60] or 'SUBBRAND'

        brand_value = None
        if id_brand not in (None, '', 'None'):
            try:
                brand_value = int(id_brand)
            except (TypeError, ValueError):
                raise nonServerErrorException('Brand harus berupa angka', 400)

        active_value = True
        if isinstance(is_active, bool):
            active_value = is_active
        elif is_active not in (None, '', 'None'):
            active_value = str(is_active).lower() in ('1', 'true', 'yes', 'aktif')

        row = self.db.session.execute(
            text("""
                UPDATE produk_subbrand
                SET
                    id_brand = :id_brand,
                    kode = :kode,
                    nama = :nama,
                    keterangan = :keterangan,
                    is_active = :is_active,
                    updated_at = NOW()
                WHERE id = :id
                RETURNING id, id_brand, kode, nama, keterangan, is_active
            """),
            {
                'id': int(id),
                'id_brand': brand_value,
                'kode': code,
                'nama': name,
                'keterangan': payload.get('keterangan') or None,
                'is_active': active_value
            }
        ).mappings().first()

        if not row:
            raise nonServerErrorException('Subbrand tidak ditemukan', 404)

        self.db.session.commit()
        result = dict(row)
        result['text'] = result.get('nama')
        return result

    @handle_error_rollback
    def delete_subbrand_option(self, id):
