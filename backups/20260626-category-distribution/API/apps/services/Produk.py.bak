    @handle_error
    def fetch_status_options(self):
        with self.db.session.begin():
            rows = (
                Produk.query.with_entities(Produk.id_status)
                .filter(Produk.id_status.isnot(None))
                .distinct()
                .order_by(Produk.id_status.asc())
                .all()
            )

        statuses = []
        for row in rows:
            value = row[0]
            statuses.append({
                'id': value,
                'nama': self._status_label(value),
                'text': self._status_label(value)
            })

        if not statuses:
            statuses = [
                {'id': 1, 'nama': 'Aktif', 'text': 'Aktif'},
                {'id': 0, 'nama': 'Nonaktif', 'text': 'Nonaktif'}
            ]

        return statuses

