    @handle_error
    def fetch_completeness_summary(self):
        rows = self.db.session.execute(
            text("""
                WITH product_flags AS (
                    SELECT
                        p.id,
                        p.id_brand,
                        p.id_subbrand,
                        COUNT(DISTINCT pu.id) AS total_uom,
                        COUNT(DISTINCT phj.id_tipe_harga) FILTER (WHERE COALESCE(phj.harga, 0) > 0) AS total_price_type,
                        COUNT(DISTINCT r.id) FILTER (WHERE r.id IS NOT NULL) AS total_promo_rule
                    FROM produk p
                    LEFT JOIN produk_uom pu ON pu.id_produk = p.id
                    LEFT JOIN produk_harga_jual phj ON phj.id_produk = p.id
                    LEFT JOIN trade_promo_program_rule r
                        ON (
                            (r.id_subbrand IS NOT NULL AND r.id_subbrand = p.id_subbrand)
                            OR EXISTS (
                                SELECT 1
                                FROM trade_promo_rule_product rp
                                WHERE rp.program_rule_id = r.id
                                  AND rp.id_produk = p.id
                                  AND COALESCE(rp.is_active, TRUE) = TRUE
                            )
                        )
                    GROUP BY p.id, p.id_brand, p.id_subbrand
                )
                SELECT
                    COUNT(*) AS total_produk,
                    COUNT(*) FILTER (WHERE id_brand IS NULL) AS missing_brand,
                    COUNT(*) FILTER (WHERE id_subbrand IS NULL) AS missing_subbrand,
                    COUNT(*) FILTER (WHERE total_uom = 0) AS missing_uom,
                    COUNT(*) FILTER (WHERE total_price_type = 0) AS missing_price_type,
                    COUNT(*) FILTER (WHERE total_promo_rule = 0) AS without_promo_mapping,
                    COUNT(*) FILTER (
                        WHERE id_brand IS NOT NULL
                          AND id_subbrand IS NOT NULL
                          AND total_uom > 0
                          AND total_price_type > 0
                    ) AS ready_for_order
                FROM product_flags
            """)
        ).mappings().first()

        return dict(rows or {})

    def fetch_price_history(self, id):
        result = (
            ProdukHargaJual.query.with_entities(
                ProdukHargaJual.id,
                ProdukHargaJual.id_produk,
                ProdukHargaJual.id_tipe_harga,
                ProdukHargaJual.harga,
                ProdukTipeHarga.nama.label('tipe_harga_nama'),
                ProdukTipeHarga.kode.label('tipe_harga_kode')
            )
            .outerjoin(ProdukTipeHarga, ProdukTipeHarga.id == ProdukHargaJual.id_tipe_harga)
            .filter(ProdukHargaJual.id_produk == id)
            .order_by(desc(ProdukHargaJual.id))
            .all()
        )

        return Mapper(result).to_dict().get()

    @handle_error
    def fetch_principal_price_rows(self, principal_id):
        search = (request.args.get('search') or '').strip()
        limit = request.args.get('limit', 300)

        try:
            limit_value = int(limit)
        except (TypeError, ValueError):
            limit_value = 300

        limit_value = max(1, min(limit_value, 500))

        params = {
            'principal_id': int(principal_id),
            'limit': limit_value
        }
        where_search = ''

        if search:
            params['search'] = f'%{search}%'
            where_search = """
                AND (
                    p.nama ILIKE :search
                    OR p.kode_sku ILIKE :search
                    OR pth.nama ILIKE :search
                    OR pth.kode ILIKE :search
                )
            """

        rows = self.db.session.execute(
            text(
                f"""
                    SELECT
                        phj.id,
                        p.id AS id_produk,
                        pth.id AS id_tipe_harga,
                        COALESCE(phj.harga, p.harga_jual, 0) AS harga,
                        p.nama AS nama_produk,
                        p.kode_sku,
                        pth.nama AS tipe_harga_nama,
                        pth.kode AS tipe_harga_kode
                    FROM produk p
                    CROSS JOIN produk_tipe_harga pth
                    LEFT JOIN produk_harga_jual phj
                        ON phj.id_produk = p.id
                        AND phj.id_tipe_harga = pth.id
                    WHERE p.id_principal = :principal_id
                    {where_search}
                    ORDER BY p.nama ASC, pth.nama ASC, pth.id ASC
                    LIMIT :limit
                """
            ),
            params
        ).mappings().all()

        return [dict(row) for row in rows]

    @handle_error_rollback
    def update_price(self, id):
        payload = request.get_json(silent=True) or {}

        id_tipe_harga = payload.get('id_tipe_harga') or self.data.get('id_tipe_harga')
        harga = payload.get('harga')
        if harga in (None, ''):
            harga = self.data.get('harga')

        if not id_tipe_harga:
            raise nonServerErrorException('Tipe harga wajib diisi', 400)

        if harga in (None, ''):
            raise nonServerErrorException('Harga wajib diisi', 400)

        try:
            harga_value = float(harga)
        except (TypeError, ValueError):
            raise nonServerErrorException('Harga harus berupa angka', 400)

        existing = (
            ProdukHargaJual.query
            .filter_by(id_produk=id, id_tipe_harga=int(id_tipe_harga))
            .first()
        )

        if existing:
            existing.harga = harga_value
        else:
            existing = ProdukHargaJual({
                'id_produk': id,
                'id_tipe_harga': int(id_tipe_harga),
                'harga': harga_value
            })
            self.db.session.add(existing)

        self.db.session.commit()

        refreshed = (
            ProdukHargaJual.query.with_entities(
                ProdukHargaJual.id,
                ProdukHargaJual.id_produk,
                ProdukHargaJual.id_tipe_harga,
                ProdukHargaJual.harga,
                ProdukTipeHarga.nama.label('tipe_harga_nama'),
                ProdukTipeHarga.kode.label('tipe_harga_kode')
            )
            .outerjoin(ProdukTipeHarga, ProdukTipeHarga.id == ProdukHargaJual.id_tipe_harga)
            .filter(ProdukHargaJual.id == existing.id)
            .first()
        )

        return dict(refreshed._mapping) if refreshed else {}

    @handle_error_rollback
    def bulk_update_prices(self):
        payload = request.get_json(silent=True) or {}
        updates = payload.get('updates') or []

        if not isinstance(updates, list) or not updates:
            raise nonServerErrorException('Daftar update harga wajib diisi', 400)

        updated_rows = []

        for item in updates:
            if not isinstance(item, dict):
                continue

            id_produk = item.get('id_produk')
            id_tipe_harga = item.get('id_tipe_harga')
            harga = item.get('harga')

            if not id_produk or not id_tipe_harga:
                raise nonServerErrorException('Produk dan tipe harga wajib diisi', 400)

            if harga in (None, ''):
                raise nonServerErrorException('Harga wajib diisi', 400)

            try:
                harga_value = float(harga)
            except (TypeError, ValueError):
                raise nonServerErrorException('Harga harus berupa angka', 400)

            existing = (
                ProdukHargaJual.query
                .filter_by(id_produk=int(id_produk), id_tipe_harga=int(id_tipe_harga))
                .first()
            )

            if existing:
                existing.harga = harga_value
            else:
                existing = ProdukHargaJual({
                    'id_produk': int(id_produk),
                    'id_tipe_harga': int(id_tipe_harga),
                    'harga': harga_value
                })
                self.db.session.add(existing)
                self.db.session.flush()

            updated_rows.append(existing.id)

        self.db.session.commit()

        refreshed = []
        if updated_rows:
            refreshed = (
                ProdukHargaJual.query.with_entities(
                    ProdukHargaJual.id,
                    ProdukHargaJual.id_produk,
                    ProdukHargaJual.id_tipe_harga,
                    ProdukHargaJual.harga,
                    Produk.nama.label('nama_produk'),
                    Produk.kode_sku.label('kode_sku'),
                    ProdukTipeHarga.nama.label('tipe_harga_nama'),
                    ProdukTipeHarga.kode.label('tipe_harga_kode')
                )
                .join(Produk, Produk.id == ProdukHargaJual.id_produk)
                .outerjoin(ProdukTipeHarga, ProdukTipeHarga.id == ProdukHargaJual.id_tipe_harga)
                .filter(ProdukHargaJual.id.in_(updated_rows))
                .order_by(Produk.nama.asc(), ProdukTipeHarga.nama.asc(), ProdukHargaJual.id.asc())
                .all()
            )

        return {
            'updated_count': len(updated_rows),
            'updated_rows': Mapper(refreshed).to_dict().get()
        }

    @handle_error_rollback
    def create_product_detail(self):
        self._ensure_ppn_schema()
        payload = request.get_json(silent=True) or {}

        product = Produk()
        self._apply_product_payload(product, payload)

        if not getattr(product, 'id_principal', None):
            raise nonServerErrorException('Principal wajib diisi', 400)

        if not (product.nama or '').strip():
            raise nonServerErrorException('Nama produk wajib diisi', 400)

        self.db.session.add(product)
        self.db.session.flush()
        self._sync_external_mappings(product, payload)
        self.db.session.commit()

        return self.fetch_detail_transaksi(product.id)

    @handle_error_rollback
    def delete_product_detail(self, id):
        product = Produk.query.filter_by(id=id).first()
        if not product:
            raise nonServerErrorException('Produk tidak ditemukan', 404)

        self.db.session.delete(product)
        self.db.session.commit()

        return {'status': 'success', 'id': id}

    def _apply_product_payload(self, product, payload):
        text_fields = ('nama', 'kode_sku', 'kode_ean', 'keterangan', 'satuan')
        integer_fields = (
            'id_principal',
            'id_brand',
            'id_kategori',
            'id_subbrand',
            'id_ppn',
            'id_status',
            'kubikasiperbox',
            'kubikasiperkarton',
            'kubikasiperpieces',
            'isiperbox',
            'isiperkarton',
        )
        float_fields = ('harga_beli', 'harga_jual', 'ppn')

        for field in text_fields:
            if field in payload:
                value = payload.get(field)
                setattr(product, field, None if value in ('', None) else str(value).strip())

        for field in integer_fields:
            if field in payload:
                value = payload.get(field)
                if value in ('', None):
                    setattr(product, field, None)
                else:
                    try:
                        setattr(product, field, int(value))
                    except (TypeError, ValueError):
                        raise nonServerErrorException(f'{field} harus berupa angka', 400)

        for field in float_fields:
            if field in payload:
                value = payload.get(field)
                if value in ('', None):
                    setattr(product, field, None)
                else:
                    try:
                        setattr(product, field, float(value))
                    except (TypeError, ValueError):
                        raise nonServerErrorException(f'{field} harus berupa angka', 400)

        if 'id_ppn' in payload and getattr(product, 'id_ppn', None):
            row = self.db.session.execute(
                text("SELECT persentase FROM master_ppn WHERE id = :id_ppn LIMIT 1"),
                {"id_ppn": int(product.id_ppn)}
            ).mappings().first()
            if row:
                product.ppn = float(row.get('persentase') or 0)

    @handle_error_rollback
    def update_product_detail(self, id):
        self._ensure_ppn_schema()
        payload = request.get_json(silent=True) or {}

        product = Produk.query.filter_by(id=id).first()
        if not product:
            raise nonServerErrorException('Produk tidak ditemukan', 404)

        self._apply_product_payload(product, payload)

        if not (product.nama or '').strip():
            raise nonServerErrorException('Nama produk wajib diisi', 400)

        self.db.session.flush()
        self._sync_external_mappings(product, payload)
        self.db.session.commit()

        refreshed = self.fetch_detail_transaksi(id)
        return refreshed


    @handle_error
    def daftar_option(self) :
        rows = []
        for item in self.fetch_option():
            if isinstance(item, dict):
                row = dict(item)
            elif hasattr(item, '_mapping'):
                row = dict(item._mapping)
            elif hasattr(item, '_asdict'):
                row = item._asdict()
            elif isinstance(item, (list, tuple)):
                row = {
                    'id': item[0] if len(item) > 0 else None,
                    'kode': item[1] if len(item) > 1 else None,
                    'nama': item[2] if len(item) > 2 else None,
                }
            else:
                row = {
                    'id': getattr(item, 'id', None),
                    'kode': getattr(item, 'kode', None),
                    'nama': getattr(item, 'nama', None),
                }

            row['text'] = f"[{row['kode']}] {row['nama']}" if row.get('kode') else f"{row.get('nama') or ''}"
            rows.append(row)

        return rows
    
    @handle_error
    def daftar_option_principal(self,id):
        def text(i):
            return (
                f"[{i['kode']}] {i['nama']}" if i['kode'] else f"{i['nama']}"
            )

