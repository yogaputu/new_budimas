            options = (
                Produk.query.with_entities(
                    Produk.id,
                    Produk.kode_sku.label('kode'),
                    Produk.nama,
                )
                .filter_by(id_principal=id)
                .all()
            )

        return (
            Mapper(options)
                .to_dict()
                .add_col(lambda i: text(i), "text")
                .get()
        )



    @handle_error
    def konversi_harga(satuan_target, satuan, produk) :
        satuan_awal   = min(satuan, key=lambda i : i['uom_level'])
        harga_awal    = produk['produk_harga_beli']
        faktor_awal   = satuan_awal['uom_faktor_konversi']
        faktor_target = satuan_target['uom_faktor_konversi']
        
        return harga_awal * (faktor_target / faktor_awal)


    @handle_error
    def konversi_jumlah(satuan_awal) :
        jumlah_awal   = satuan_awal['jumlah']
        faktor_awal   = satuan_awal['uom_faktor_konversi']
        faktor_target = 1
        
        return jumlah_awal * (faktor_awal / faktor_target)
    
    def konversi_jumlah_total(satuan) :
        total = 0
        for satuan_awal in satuan :
            if satuan_awal and satuan_awal['jumlah'] :
                jumlah_awal   = int(satuan_awal['jumlah']) 
                faktor_awal   = int(satuan_awal['uom_faktor_konversi'])
                faktor_target = 1
                total         += jumlah_awal * (faktor_awal / faktor_target)
        
        return total

    @handle_error
    def getProducts(self):
        return (
            self.query().setRawQuery(
            """
                SELECT * FROM produk
            """
            ).execute().fetchall()
        )

    def getProduct(self):
        id_cabang = self.req('id_cabang')
        id_produk = self.req('id_produk')

        res = self.query().setRawQuery(
            """
                SELECT 
                    produk.*, 
                    stok.jumlah_ready,
                    stok.jumlah_booked,
                    stok.jumlah_delivery,
                    stok.jumlah_incoming,
                    stok.jumlah_gudang,
                    stok.jumlah_good,
                    stok.jumlah_bad,
                    stok.tanggal_update,
                    uom1.faktor_konversi AS konversi_1,
                    uom2.faktor_konversi AS konversi_2,
                    uom3.faktor_konversi AS konversi_3
                FROM produk
                JOIN stok 
                    ON produk.id = stok.produk_id
                LEFT JOIN produk_uom uom1 
                    ON uom1.id_produk = produk.id AND uom1.level = 1
                LEFT JOIN produk_uom uom2 
                    ON uom2.id_produk = produk.id AND uom2.level = 2
                LEFT JOIN produk_uom uom3 
                    ON uom3.id_produk = produk.id AND uom3.level = 3
                WHERE 
                    stok.produk_id = :id_produk
                    AND stok.cabang_id = :id_cabang
            """
        ).bindparams({
            "id_produk": id_produk,
            "id_cabang": id_cabang
        }).execute().fetchone().result

        return res

    # this function get principal products that have relation with customer and sales
    @handle_error
    def getPlafonProduks(self):
        products = (
            self.query()
            .setRawQuery(
            f"""
            SELECT 
               principal.id AS id_principal,
               principal.nama AS nama_principal,
               produk.id,
               produk.id_brand,
               produk.id_subbrand,
               produk.id_kategori,
               produk.id_status,
               produk.kode_sku,
               produk.kode_ean,
               produk.nama,
               produk_subbrand.nama AS subbrand_nama,
               produk.harga_beli,
               produk.keterangan,
               produk.ppn,
               produk_harga_jual.harga as harga_jual,
               MAX(CASE WHEN produk_uom.level = 1 THEN produk_uom.faktor_konversi END) as konversi_1,
               MAX(CASE WHEN produk_uom.level = 2 THEN produk_uom.faktor_konversi END) as konversi_2, 
               MAX(CASE WHEN produk_uom.level = 3 THEN produk_uom.faktor_konversi END) as konversi_3,
               MAX(CASE WHEN produk_uom.level = 1 THEN produk_uom.nama END) as konversi_1_nama,
               MAX(CASE WHEN produk_uom.level = 2 THEN produk_uom.nama END) as konversi_2_nama, 
               MAX(CASE WHEN produk_uom.level = 3 THEN produk_uom.nama END) as konversi_3_nama
            FROM plafon
            LEFT JOIN customer ON customer.id = plafon.id_customer
            LEFT JOIN principal ON principal.id = plafon.id_principal  
            LEFT JOIN sales ON sales.id = plafon.id_sales
            LEFT JOIN users ON users.id = sales.id_user
            LEFT JOIN produk ON produk.id_principal = principal.id
            LEFT JOIN produk_subbrand ON produk_subbrand.id = produk.id_subbrand
            LEFT JOIN produk_harga_jual ON produk.id = produk_harga_jual.id_produk
            LEFT JOIN produk_uom ON produk.id = produk_uom.id_produk
            WHERE 
               plafon.id_user = :user_id AND
               plafon.id_customer = :customer_id AND 
               plafon.id_principal = :principal_id AND
               plafon.id_tipe_harga = produk_harga_jual.id_tipe_harga
            GROUP BY
               principal.id,
               principal.nama,
               produk.id,
               produk.id_principal,
               produk.id_brand,
               produk.id_subbrand,
               produk.id_kategori, 
               produk.id_status,
               produk.kode_sku,
               produk.kode_ean,
               produk.nama,
               produk_subbrand.nama,
               produk.harga_beli,
               produk.keterangan,
               produk.ppn,
               produk_harga_jual.harga
            """
            )
            .bindparams({
                "user_id": self.req("user_id"),
                "customer_id": self.req("customer_id"),
                "principal_id": self.req("principal_id")
            })
            .execute()
            .fetchall()
            .get()
        )

        return products

    @handle_error
    def getStokReady(self):
        id_cabang = self.req('id_cabang')
        id_produk = self.req('id_produk')

        res = self.query().setRawQuery(
            """
                SELECT 
                stok.jumlah_ready

                FROM produk
                JOIN stok ON produk.id = stok.produk_id 
                WHERE 
                stok.produk_id = :id_produk
                AND
                stok.cabang_id = :id_cabang
            """
        ).bindparams({
            "id_produk": id_produk,
            "id_cabang": id_cabang
        }).execute().fetchone().get()

        return res

    @staticmethod
    def _parse_id_list(value):
        if isinstance(value, (list, tuple)):
            values = value
        else:
            values = str(value or '').split(',')

        parsed = []
        for item in values:
            try:
                numeric = int(str(item).strip())
            except (TypeError, ValueError):
                continue
            if numeric > 0 and numeric not in parsed:
                parsed.append(numeric)
        return parsed

    def _request_principal_ids(self):
        raw_values = []
        for key in ('principal_ids', 'principal_ids[]', 'principal_id', 'principal_id[]'):
            raw_values.extend(request.args.getlist(key))

        if not raw_values:
            raw_values.append(self.req("principal_ids"))
            raw_values.append(self.req("principal_id"))

        principal_ids = []
        for raw_value in raw_values:
            for principal_id in self._parse_id_list(raw_value):
                if principal_id not in principal_ids:
                    principal_ids.append(principal_id)

        return principal_ids

    @handle_error
    def getProdukSalesOrder(self):
        self._ensure_ppn_schema()
        # Ambil parameter dari request
        user_id = self.req("user_id")
        customer_id = self.req("customer_id")
        principal_ids = self._request_principal_ids()
        cabang_id = self.req("id_cabang")

        if not principal_ids:
            return []

        # Raw Query yang sudah menyertakan stok_ready
        query = """
            SELECT 
                p.id, p.nama, p.kode_sku, p.id_principal, p.id_subbrand,
                pr.nama AS nama_principal,
                pr.kode AS kode_principal,
                p.id_ppn,
                mp.nama AS ppn_nama,
                mp.kode AS ppn_kode,
                COALESCE(mp.persentase, p.ppn, 0) AS ppn,
                CASE WHEN p.id_ppn IS NULL AND p.ppn IS NULL THEN TRUE ELSE FALSE END AS ppn_missing,
                ps.nama AS subbrand_nama,
                phj.harga as harga_jual,
                s.jumlah_ready as stok_ready,
                MAX(CASE WHEN u.level = 1 THEN u.faktor_konversi END) as konversi_1,
                MAX(CASE WHEN u.level = 2 THEN u.faktor_konversi END) as konversi_2,
                MAX(CASE WHEN u.level = 3 THEN u.faktor_konversi END) as konversi_3,
                MAX(CASE WHEN u.level = 1 THEN u.nama END) as uom_1,
                MAX(CASE WHEN u.level = 2 THEN u.nama END) as uom_2,
                MAX(CASE WHEN u.level = 3 THEN u.nama END) as uom_3
            FROM produk p
            JOIN plafon pl ON p.id_principal = pl.id_principal
            JOIN principal pr ON pr.id = p.id_principal
            LEFT JOIN sales sales_plafon ON sales_plafon.id = pl.id_sales
            JOIN produk_harga_jual phj ON p.id = phj.id_produk AND pl.id_tipe_harga = phj.id_tipe_harga
            LEFT JOIN master_ppn mp ON mp.id = p.id_ppn
            LEFT JOIN produk_subbrand ps ON ps.id = p.id_subbrand
            LEFT JOIN stok s ON p.id = s.produk_id AND s.cabang_id = :id_cabang
            LEFT JOIN produk_uom u ON p.id = u.id_produk
            WHERE (pl.id_user = :user_id OR sales_plafon.id_user = :user_id)
            AND pl.id_customer = :customer_id
            AND pl.id_principal IN :principal_ids
            AND p.id_principal IN :principal_ids
            AND COALESCE(pr.aktif, TRUE) = TRUE
            AND UPPER(TRIM(COALESCE(pr.kode, ''))) NOT IN ('MIX', 'M1', 'M2', 'M3', 'MFB', 'MFT')
            AND UPPER(TRIM(COALESCE(pr.nama, ''))) NOT IN ('MIX', 'M1', 'M2', 'M3', 'MFB', 'MFT')
            AND NOT (UPPER(TRIM(COALESCE(pr.kode, ''))) ~ '^MIX[[:space:]#-]*[0-9]*$')
            AND NOT (UPPER(TRIM(COALESCE(pr.nama, ''))) ~ '^MIX[[:space:]#-]*[0-9]*$')
            GROUP BY p.id, pr.id, pr.nama, pr.kode, mp.id, ps.nama, phj.harga, s.jumlah_ready
        """
        return self.query().setRawQuery(query).bindparams({
            "user_id": user_id,
            "customer_id": customer_id,
            "principal_ids": principal_ids,
            "id_cabang": cabang_id
        }).execute().fetchall().get()
    
