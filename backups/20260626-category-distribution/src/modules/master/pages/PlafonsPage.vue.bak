});

const availablePrincipalIds = computed(() => {
  const ids = salesPrincipalAssignments.value
    .map((item) => Number(item.id_principal))
    .filter(Boolean);

  return [...new Set(ids)];
});

const filteredPrincipals = computed(() => {
