const selectedUser = computed(() =>
  users.value.find((item) => String(item.id) === String(form.id_user)) ||
  (
    form.id_user && String(firstFilled(selectedRow.value, ['id_user', 'id_user_sales', 'sales_id_user', 'user_id']) || '') === String(form.id_user)
