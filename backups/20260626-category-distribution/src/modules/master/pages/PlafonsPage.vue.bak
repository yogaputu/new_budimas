            :empty-text="optionLoading.prices ? 'Memuat tipe harga...' : 'Tipe harga belum tersedia.'"
          />

          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-slate-700 dark:text-slate-300">
