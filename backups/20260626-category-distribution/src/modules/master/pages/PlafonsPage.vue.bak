        >
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300">
            Customer Plafon Terpilih
          </p>
          <p class="mt-1 text-base font-bold text-slate-900 dark:text-white">
