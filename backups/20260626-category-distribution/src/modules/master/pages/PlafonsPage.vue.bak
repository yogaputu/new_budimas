  if (!form.id_sales || availablePrincipalIds.value.length === 0) {
    return scoped;
  }

  return scoped.filter((item) =>
    availablePrincipalIds.value.includes(Number(item.id)) ||
    String(item.id) === String(form.id_principal || '')
