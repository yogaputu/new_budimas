+@mobile_endpoint(True)
+def mobile_accept(s,i,id): return s.accept_lph(i,id,body())
+@mobile_receipt_workflow.post('/lphs/<int:id>/claims')
+@mobile_endpoint(True)
+def mobile_claim(s,i,id): return s.mobile_claim(i,id,body())
+@mobile_receipt_workflow.delete('/claims/<int:id>')
