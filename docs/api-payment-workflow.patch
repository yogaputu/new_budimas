@@ -0,0 +1,556 @@
+"""Transactional receipt/Giro workflow. Legacy deposits are projected only at finalization."""
+import json
+import hashlib
+from datetime import date
+from decimal import Decimal
+from uuid import uuid4
+from sqlalchemy import text
+from apps import native_db
+from apps.lib.finance_access import finance_actor, assert_finance_scope, scope_conditions, positive_id, money, iso_date
+from apps.lib.cashier_expense import resolve_expense_scope
+from apps.lib.schema_guard import require_tables
+from .rules import fail, key, note, nonnegative, receipt_split, distinct_approver, fund_payload
+
+MIGRATION='tools/migrations/20261004_payment_receipt_workflow.sql'
+PURPOSES=('CASH','BANK','GIRO','CLEARING','RECEIVABLE','ADVANCE','RETURN','FEE')
+ACTIVE="('DRAFT','FINALIZED','CANCEL_REQUESTED')"
+INVOICE_SQL='''SELECT DISTINCT f.id, f.no_faktur, f.id_sales_order, f.id_order_batch,
+ COALESCE(f.total_penjualan,0)::numeric total, COALESCE(f.nominal_retur,0)::numeric existing_return,
+ so.id AS source_order, c.id AS id_customer, c.nama AS nama_customer,
+ c.id_cabang, pr.id_perusahaan, pl.id_principal
+ FROM lph_detail ld JOIN faktur f ON f.id=ld.id_faktur
+ JOIN sales_order so ON so.id=COALESCE(f.id_sales_order,
+   (SELECT MIN(fd.id_sales_order) FROM faktur_detail fd WHERE fd.id_faktur=f.id))
+ JOIN plafon pl ON pl.id=so.id_plafon JOIN customer c ON c.id=pl.id_customer
+ JOIN principal pr ON pr.id=pl.id_principal
+ WHERE ld.id_lph=:id ORDER BY f.id'''
+
+class PaymentWorkflow:
+    def __init__(self, session=None):
+        self.session=session if session is not None else native_db.session
+
+    def one(self, sql, **params):
+        row=self.session.execute(text(sql),params).mappings().first()
+        return dict(row) if row else None
+
+    def all(self, sql, **params):
+        return [dict(r) for r in self.session.execute(text(sql),params).mappings().all()]
+
