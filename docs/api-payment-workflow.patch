+    if request.method!='OPTIONS': return token_auth.login_required(lambda:None)()
+
+
+def endpoint(permission,write=False):
+    def decorate(fn):
+        @wraps(fn)
+        @handle_error_rollback
+        def run(*args,**kwargs):
+            service=PaymentWorkflow()
+            actor=service.actor(permission)
+            try:
+                result=fn(service,actor,*args,**kwargs)
+                if write: service.session.commit()
+                return jsonify({'data':result})
+            except IntegrityError:
+                service.session.rollback()
+                fail('Referensi transaksi sudah dipakai atau data berubah. Muat ulang daftar.',409)
+        return run
+    return decorate
+
+
+def body():
+    data=request.get_json(silent=True)
+    if not isinstance(data,dict): fail('Data JSON tidak valid.')
+    return data
+
