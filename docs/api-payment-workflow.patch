+-- Additive receipt/Giro rollout. Existing LPHs retain workflow version 1.
+BEGIN;
+ALTER TABLE lph ADD COLUMN IF NOT EXISTS payment_workflow_version INTEGER NOT NULL DEFAULT 1;
+CREATE TABLE IF NOT EXISTS finance_workflow_setting (
+ id_perusahaan INTEGER PRIMARY KEY REFERENCES perusahaan(id), enabled BOOLEAN NOT NULL DEFAULT FALSE, max_fee NUMERIC(18,2) NOT NULL DEFAULT 2900 CHECK(max_fee>=0)
+);
+CREATE TABLE IF NOT EXISTS finance_workflow_account (
+ id_perusahaan INTEGER REFERENCES perusahaan(id), purpose TEXT NOT NULL,
+ id_coa INTEGER NOT NULL REFERENCES coa(id_coa),
+ PRIMARY KEY(id_perusahaan,purpose),
+ CHECK(purpose IN ('CASH','BANK','GIRO','CLEARING','RECEIVABLE','ADVANCE','RETURN','FEE'))
+);
+CREATE TABLE IF NOT EXISTS finance_lph_claim (
+ id BIGSERIAL PRIMARY KEY, id_lph INTEGER NOT NULL REFERENCES lph(id),
+ id_faktur INTEGER NOT NULL REFERENCES faktur(id), method TEXT NOT NULL CHECK(method IN ('CASH','TRANSFER','GIRO')),
+ amount NUMERIC(18,2) NOT NULL CHECK(amount>0), giro_number TEXT, bank TEXT, due_date DATE,
+ client_key UUID NOT NULL, created_by INTEGER NOT NULL REFERENCES users(id), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+ UNIQUE(created_by,client_key), CHECK(method<>'GIRO' OR (length(btrim(giro_number))>0 AND length(btrim(bank))>0 AND due_date IS NOT NULL))
+);
+CREATE TABLE IF NOT EXISTS finance_lph_handover (
+ id_lph INTEGER PRIMARY KEY REFERENCES lph(id), cash_transfer NUMERIC(18,2) NOT NULL CHECK(cash_transfer>=0),
+ cash_to_cashier NUMERIC(18,2) NOT NULL CHECK(cash_to_cashier>=0), submitted_by INTEGER NOT NULL REFERENCES users(id),
+ created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE IF NOT EXISTS finance_fund_source (
+ id BIGSERIAL PRIMARY KEY, id_perusahaan INTEGER NOT NULL REFERENCES perusahaan(id), id_cabang INTEGER NOT NULL REFERENCES cabang(id),
+ id_sales INTEGER REFERENCES sales(id), id_customer INTEGER REFERENCES customer(id),
+ kind TEXT NOT NULL CHECK(kind IN ('CASH','TRANSFER','GIRO','ADVANCE','RETURN')),
+ reference TEXT NOT NULL, bank TEXT NOT NULL DEFAULT '', account_name TEXT, received_date DATE NOT NULL,
+ due_date DATE, amount NUMERIC(18,2) NOT NULL CHECK(amount>0),
+ approval TEXT NOT NULL CHECK(approval IN ('PENDING','APPROVED')), giro_status TEXT,
+ id_lph INTEGER REFERENCES lph(id), id_mutasi INTEGER REFERENCES mutasi_bank(id_mutasi),
+ id_credit_note INTEGER REFERENCES credit_note(id_cn), origin_receipt BIGINT,
+ client_key UUID NOT NULL, created_by INTEGER NOT NULL REFERENCES users(id), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+ UNIQUE(created_by,client_key), UNIQUE(id_perusahaan,kind,reference,bank), UNIQUE(id_mutasi), UNIQUE(id_credit_note),
+ CHECK(kind<>'GIRO' OR (giro_status IN ('NOT_CLEARED','CLEARED','BOUNCED') AND due_date IS NOT NULL AND length(bank)>0))
+);
+CREATE TABLE IF NOT EXISTS finance_receipt (
+ id BIGSERIAL PRIMARY KEY, id_lph INTEGER NOT NULL REFERENCES lph(id), id_perusahaan INTEGER NOT NULL REFERENCES perusahaan(id),
+ id_cabang INTEGER NOT NULL REFERENCES cabang(id), number TEXT NOT NULL, receipt_date DATE NOT NULL,
+ status TEXT NOT NULL CHECK(status IN ('DRAFT','FINALIZED','CANCEL_REQUESTED','CANCELLED')),
+ created_by INTEGER NOT NULL REFERENCES users(id), finalized_by INTEGER REFERENCES users(id), finalized_at TIMESTAMPTZ,
+ client_key UUID NOT NULL, request_hash TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1,
+ UNIQUE(id_perusahaan,number), UNIQUE(created_by,client_key)
+);
+ALTER TABLE finance_fund_source DROP CONSTRAINT IF EXISTS finance_fund_source_origin_receipt_fkey;
+ALTER TABLE finance_fund_source ADD CONSTRAINT finance_fund_source_origin_receipt_fkey FOREIGN KEY(origin_receipt) REFERENCES finance_receipt(id);
+CREATE TABLE IF NOT EXISTS finance_receipt_invoice (
+ id BIGSERIAL PRIMARY KEY, id_receipt BIGINT NOT NULL REFERENCES finance_receipt(id), id_faktur INTEGER NOT NULL REFERENCES faktur(id),
+ id_customer INTEGER NOT NULL REFERENCES customer(id), paid NUMERIC(18,2) NOT NULL CHECK(paid>0),
+ excess NUMERIC(18,2) NOT NULL DEFAULT 0 CHECK(excess>=0), excess_treatment TEXT CHECK(excess_treatment IN ('ADVANCE','FEE')),
+ UNIQUE(id_receipt,id_faktur)
+);
+CREATE TABLE IF NOT EXISTS finance_receipt_allocation (
+ id BIGSERIAL PRIMARY KEY, id_receipt BIGINT NOT NULL REFERENCES finance_receipt(id), id_faktur INTEGER NOT NULL REFERENCES faktur(id),
+ id_source BIGINT REFERENCES finance_fund_source(id), fee_name TEXT,
+ amount NUMERIC(18,2) NOT NULL CHECK(amount>0), CHECK((id_source IS NOT NULL) <> (fee_name IS NOT NULL))
+);
+CREATE TABLE IF NOT EXISTS finance_receipt_legacy_link (
+ id_receipt BIGINT NOT NULL REFERENCES finance_receipt(id), id_setoran INTEGER NOT NULL REFERENCES setoran(id),
+ id_setoran_customer INTEGER NOT NULL REFERENCES setoran_customer(id), PRIMARY KEY(id_receipt,id_setoran)
+);
+CREATE TABLE IF NOT EXISTS finance_receipt_cancellation (
+ id BIGSERIAL PRIMARY KEY, id_receipt BIGINT NOT NULL REFERENCES finance_receipt(id),
+ status TEXT NOT NULL CHECK(status IN ('DRAFT','PENDING','APPROVED','REJECTED')),
+ reason TEXT NOT NULL, auto_giro BIGINT REFERENCES finance_fund_source(id),
+ requested_by INTEGER REFERENCES users(id), decided_by INTEGER REFERENCES users(id), decided_at TIMESTAMPTZ,
+ created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE UNIQUE INDEX IF NOT EXISTS finance_cancel_active ON finance_receipt_cancellation(id_receipt) WHERE status IN ('DRAFT','PENDING');
+CREATE TABLE IF NOT EXISTS finance_giro_clearing (
+ id BIGSERIAL PRIMARY KEY, id_source BIGINT NOT NULL UNIQUE REFERENCES finance_fund_source(id),
+ id_perusahaan INTEGER NOT NULL REFERENCES perusahaan(id), reference TEXT NOT NULL,
+ id_mutasi INTEGER UNIQUE REFERENCES mutasi_bank(id_mutasi), amount NUMERIC(18,2) NOT NULL,
+ created_by INTEGER NOT NULL REFERENCES users(id), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+ UNIQUE(id_perusahaan,reference)
+);
+CREATE TABLE IF NOT EXISTS finance_workflow_journal (
+ id BIGSERIAL PRIMARY KEY, reference TEXT NOT NULL UNIQUE, id_jurnal INTEGER NOT NULL REFERENCES jurnal(id_jurnal),
+ id_perusahaan INTEGER NOT NULL REFERENCES perusahaan(id), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE IF NOT EXISTS finance_workflow_audit (
+ id BIGSERIAL PRIMARY KEY, id_perusahaan INTEGER NOT NULL REFERENCES perusahaan(id), entity TEXT NOT NULL, entity_id BIGINT NOT NULL,
+ action TEXT NOT NULL, actor_id INTEGER NOT NULL REFERENCES users(id), note TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE INDEX IF NOT EXISTS finance_claim_lph ON finance_lph_claim(id_lph,id_faktur);
+CREATE INDEX IF NOT EXISTS finance_allocation_source ON finance_receipt_allocation(id_source,id_receipt);
+CREATE INDEX IF NOT EXISTS finance_receipt_lph ON finance_receipt(id_lph,status);
+-- Register explicit capabilities only; never grant business approval automatically.
+LOCK TABLE fitur IN SHARE ROW EXCLUSIVE MODE;
+WITH missing AS (
+ SELECT code, row_number() OVER(ORDER BY code) rn FROM (VALUES
+ ('finance.receipts.view'),('finance.receipts.create'),('finance.receipts.approve'),
+ ('finance.receipts.cancel'),('finance.receipts.cancel-approve'),
+ ('finance.funds.view'),('finance.funds.create'),('finance.funds.approve'),
+ ('finance.giro.clear'),('finance.giro.bounce'),('finance.workflow.configure')
+ ) p(code) WHERE NOT EXISTS(SELECT 1 FROM fitur f WHERE f.nama=p.code)
+), last_id AS(SELECT COALESCE(MAX(id),0) n FROM fitur)
+INSERT INTO fitur(id,nama) SELECT n+rn,code FROM missing CROSS JOIN last_id;
+DO $$ DECLARE seq TEXT; BEGIN
+ SELECT pg_get_serial_sequence('fitur','id') INTO seq;
+ IF seq IS NOT NULL THEN PERFORM setval(seq::regclass,GREATEST((SELECT COALESCE(MAX(id),1) FROM fitur),1),true); END IF;
+END $$;
+COMMIT;
-- 
