+++ b/apps/services/FinanceWorkflow/rules.py
@@ -0,0 +1,58 @@
+from decimal import Decimal
+from uuid import UUID
+from apps.handler import nonServerErrorException
+from apps.lib.finance_access import money, iso_date, positive_id
+
+
+def fail(message, code=400):
+    raise nonServerErrorException(message, code)
+
+
+def key(value):
+    try:
+        return str(UUID(str(value)))
+    except (ValueError, TypeError, AttributeError):
+        fail('ID transaksi tidak valid. Buka ulang form.')
+
+
+def note(value):
+    value = str(value or '').strip()
+    if not value or len(value)>2000:
+        fail('Alasan wajib diisi, maksimal 2.000 karakter.')
+    return value
+
+
+def nonnegative(value):
+    if value in (0, '0', '0.00', None, ''):
+        return Decimal('0.00')
+    return money(value)
+
+
+def receipt_split(total, remaining, treatment):
+    total, remaining = Decimal(str(total)), Decimal(str(remaining))
+    if total<=0 or remaining<=0:
+        fail('Faktur sudah lunas atau belum ada sumber dana.',409)
+    excess=max(total-remaining, Decimal(0))
+    if excess and treatment not in ('ADVANCE','FEE'):
+        fail('Pilih perlakuan kelebihan dana: uang muka atau biaya lain.')
+    return min(total,remaining),excess
+
+
+def distinct_approver(created_by, actor):
+    if int(created_by)==int(actor):
+        fail('Pembuat transaksi tidak boleh memutuskan transaksinya sendiri.',403)
+
+
+def fund_payload(data):
+    if not isinstance(data,dict): fail('Data setoran tidak valid.')
+    kind=data.get('kind')
+    if kind not in ('CASH','TRANSFER','GIRO'): fail('Jenis setoran tidak valid.')
+    result={k:positive_id(data.get(k),k) for k in ('id_perusahaan','id_cabang')}
+    result.update(kind=kind,reference=note(data.get('reference'))[:160],bank=str(data.get('bank') or '').strip()[:160],
+                  received_date=iso_date(data.get('received_date')),amount=money(data.get('amount')),client_key=key(data.get('client_key')),
+                  id_sales=positive_id(data['id_sales']) if data.get('id_sales') else None,
+                  account_name=str(data.get('account_name') or '').strip()[:160],due_date=None)
+    if kind=='GIRO':
+        if not result['bank']: fail('Bank giro wajib diisi.')
+        result['due_date']=iso_date(data.get('due_date'))
+    return result
